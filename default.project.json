{
  "name": "TapAndHatch",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "PetModels": {
        "$path": "assets/PetModels"
      },
      "EggModels": {
        "$path": "assets/EggModels"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CameraMaxZoomDistance": 60
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.6
        ]
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
