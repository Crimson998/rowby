{
  "name": "TapAndHatch",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "PetModels": {
        "$path": "assets/PetModels",
        "$ignoreUnknownInstances": true
      },
      "EggModels": {
        "$path": "assets/EggModels",
        "$ignoreUnknownInstances": true
      },
      "StudioAssets": {
        "$path": "assets/ReplicatedStorage",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "StudioAssets": {
        "$path": "assets/ServerStorage",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterGui": {
      "StudioGui": {
        "$path": "assets/StarterGui",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CameraMode": "Classic",
        "CameraMinZoomDistance": 0.5,
        "CameraMaxZoomDistance": 60,
        "DevComputerCameraMovementMode": "UserChoice",
        "DevTouchCameraMovementMode": "UserChoice",
        "DevCameraOcclusionMode": "Zoom",
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": false,
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$ignoreUnknownInstances": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "StudioBuilds": {
        "$path": "assets/Workspace",
        "$ignoreUnknownInstances": true
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.6
        ]
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
